# Copy outside git before filling values, for example:
#   cp ops/deriv-demo-executor.env.example ~/.config/binary-algo/deriv-demo-executor.env
DERIV_APP_ID=replace_with_deriv_app_id
DERIV_PAT=replace_with_demo_pat
DERIV_ACCOUNT_ID=replace_with_demo_account_id

DERIV_DEMO_PAIRS=all-enabled
DERIV_DEMO_LOG_DIR=/home/sean/git/binary-algo/logs/paper_trades
DERIV_DEMO_STORE_DIR=/home/sean/git/binary-algo/deriv_data/candles_1m
DERIV_DEMO_STAKE=1

# Payout-aware edge gate (see docs/DERIV_DEMO_EXECUTOR.md):
#   effective_floor = side_refit_p10 - haircut_abs - payout_edge_margin
# A buy requires effective_floor > live_breakeven (ask/payout).
# This is only the secondary absolute live-breakeven ceiling.
DERIV_DEMO_ABSOLUTE_BREAKEVEN_CEILING=0.60
# Deprecated compatibility alias; the scripts still honor it if the new name is
# absent in an existing private env file.
# DERIV_DEMO_MAX_BREAKEVEN=0.60
DERIV_DEMO_PAYOUT_EDGE_MARGIN=0.005

# OLD-TIMER-ERA (deprecated with deriv-demo-executor.timer, issue #5): read
# only by the old executor; unread by the candle-refresh + quote-audit jobs.
# Quote snapshot mode: "all" (normative default) snapshots CALL+PUT for every
# enabled pair each cycle (12 proposal requests per cycle at all-enabled);
# "off" is the reduced-cadence override.
DERIV_DEMO_QUOTE_SNAPSHOTS=all

# OLD-TIMER-ERA (deprecated with deriv-demo-executor.timer, issue #5).
# Execution mode: proposal-only by default. Switch to --demo-buy only after a
# proposal-only VPS run has verified proposal payloads, the payout gate, haircut
# resolution, and structured logs.
DERIV_DEMO_MODE_ARGS=--dry-run-proposal-only

# Hot runtime supervisor mode (issue #4 Phase 4): empty = proposal-only.
# Set to --demo-buy only per the Phase-4 gate, and drop --demo-buy from
# DERIV_DEMO_MODE_ARGS first — exactly one buy-capable process may exist.
DERIV_SUPERVISOR_MODE_ARGS=
