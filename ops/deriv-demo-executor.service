[Unit]
Description=binary-algo Deriv demo executor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/binary-algo/deriv-demo-executor.env
WorkingDirectory=/home/sean/git/binary-algo
# Rolling-store refresh dependency: the executor's store health gate requires the
# 1m candle store to be fresh (max-stale default 180s); refresh before every run.
ExecStartPre=/home/sean/binary-algo-venv/bin/python scripts/deriv_backfill.py backfill --pairs all --out-dir ${DERIV_DEMO_STORE_DIR} --max-pages 2
ExecStart=/home/sean/binary-algo-venv/bin/python scripts/deriv_demo_executor.py --pairs ${DERIV_DEMO_PAIRS} --store-dir ${DERIV_DEMO_STORE_DIR} --log-dir ${DERIV_DEMO_LOG_DIR} --stake ${DERIV_DEMO_STAKE} --max-breakeven ${DERIV_DEMO_MAX_BREAKEVEN} --payout-edge-margin ${DERIV_DEMO_PAYOUT_EDGE_MARGIN} --quote-snapshots ${DERIV_DEMO_QUOTE_SNAPSHOTS} $DERIV_DEMO_MODE_ARGS --once
KillSignal=SIGINT
TimeoutStartSec=1800
Nice=5

[Install]
WantedBy=default.target
