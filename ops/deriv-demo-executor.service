# DEPRECATED (issue #5, 2026-07-02): superseded by
# deriv-production-candle-refresh.timer (store freshness) +
# deriv-quote-audit.service (quote_snapshot rows). Retained disabled per the
# docs/DERIV_DEMO_EXECUTOR.md cutover runbook. Do NOT run alongside the
# refresh timer: both write the same deriv_data/candles_1m/{pair}.parquet.tmp
# paths — concurrent backfills corrupt the store.
[Unit]
Description=binary-algo Deriv demo executor (DEPRECATED — see issue #5)
After=network-online.target
Wants=network-online.target
Conflicts=deriv-trade-executor.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/binary-algo/deriv-demo-executor.env
WorkingDirectory=/home/sean/git/binary-algo
# Rolling-store refresh dependency: the executor's store health gate requires the
# 1m candle store to be fresh (max-stale default 180s); refresh before every run.
UnsetEnvironment=DERIV_PAT DERIV_ACCOUNT_ID DERIV_DEMO_MODE_ARGS DERIV_SUPERVISOR_MODE_ARGS
ExecStartPre=/home/sean/binary-algo-venv/bin/python scripts/deriv_backfill.py backfill --pairs all --out-dir ${DERIV_DEMO_STORE_DIR} --max-pages 2
ExecStart=/home/sean/binary-algo-venv/bin/python scripts/deriv_demo_executor.py --pairs ${DERIV_DEMO_PAIRS} --store-dir ${DERIV_DEMO_STORE_DIR} --log-dir ${DERIV_DEMO_LOG_DIR} --stake ${DERIV_DEMO_STAKE} --max-breakeven ${DERIV_DEMO_MAX_BREAKEVEN} --payout-edge-margin ${DERIV_DEMO_PAYOUT_EDGE_MARGIN} --quote-snapshots ${DERIV_DEMO_QUOTE_SNAPSHOTS} --dry-run-proposal-only --once
KillSignal=SIGINT
TimeoutStartSec=1800
Nice=5

[Install]
WantedBy=default.target
