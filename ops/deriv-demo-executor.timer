# DEPRECATED (issue #5, 2026-07-02): superseded by
# deriv-production-candle-refresh.timer + deriv-quote-audit.service.
# Retained disabled per the docs/DERIV_DEMO_EXECUTOR.md cutover runbook.
[Unit]
Description=Run binary-algo Deriv demo executor each minute (DEPRECATED — see issue #5)

[Timer]
OnBootSec=90
OnUnitActiveSec=60
AccuracySec=5
Persistent=false
Unit=deriv-demo-executor.service

[Install]
WantedBy=timers.target
