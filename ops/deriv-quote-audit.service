[Unit]
Description=binary-algo Deriv quote-audit sampler (12-lane quote_snapshot rows for the Phase-5 enable bar; issue #5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/binary-algo/deriv-demo-executor.env
WorkingDirectory=/home/sean/git/binary-algo
# Buy-incapable by construction: PUBLIC socket only; deriv_quote_workers.py
# contains no authorize, no buy payload, no PAT read (AST-gated in --smoke).
# The credentials the sampler does not need are dropped outright (KILL #6
# posture exceeded, not just met).
UnsetEnvironment=DERIV_PAT DERIV_ACCOUNT_ID DERIV_DEMO_MODE_ARGS DERIV_SUPERVISOR_MODE_ARGS
ExecStart=/home/sean/binary-algo-venv/bin/python scripts/deriv_quote_workers.py --audit --log-dir ${DERIV_DEMO_LOG_DIR}/quote_audit --sample-seconds 30 --stake ${DERIV_DEMO_STAKE}
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
Nice=5
# RSS ceiling (issue #5 acceptance: sampler < 300 MB). Measured 2026-07-02:
# ~200 MB peak. MemoryHigh throttles reclaim near the 300 MB target;
# MemoryMax is a hard backstop that OOM-kills a genuine leak (Restart= then
# revives it fresh) rather than letting it grow unbounded.
MemoryHigh=300M
MemoryMax=450M

# Restart= survives crashes, not reboots: the runbook enables this unit
# (systemctl --user enable --now) so >=3-NY-session coverage keeps accruing
# across a VPS reboot.
[Install]
WantedBy=default.target
