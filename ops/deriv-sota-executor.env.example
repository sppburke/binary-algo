# Copy outside git before filling real credentials (chmod 600):
#   mkdir -p ~/.config/binary-algo && chmod 700 ~/.config/binary-algo
#   cp ops/deriv-sota-executor.env.example ~/.config/binary-algo/deriv-sota-executor.env
#   chmod 600 ~/.config/binary-algo/deriv-sota-executor.env

# --- Jurisdiction Guard (Mandatory: Direct Deriv Connections Allowed ONLY from Mexico VPS) ---
# Must be set to "mexico_vps" ONLY on the Mexico VPS; never set this on a USA machine.
DERIV_HOST_JURISDICTION=mexico_vps

# --- Deriv API Credentials ---
# Option 1 (Dedicated Demo PAT; receipt credential_isolation_mode="revoked"):
#   Fill DERIV_APP_ID, DERIV_PAT, and DERIV_ACCOUNT_ID below.
# Option 2 (Opt-in single-host Demo reuse with all 4 legacy units masked; receipt
#   credential_isolation_mode="single_host_units_masked"):
#   Comment out these 3 lines and install ops/deriv-sota-executor.single-host-demo.conf as a
#   systemd drop-in so systemd inherits them from ~/.config/binary-algo/deriv-demo-executor.env.
DERIV_APP_ID=replace_with_deriv_app_id
DERIV_PAT=replace_with_dedicated_demo_pat
# Demo account IDs use VRTC* / VRW* (WS v3) or D[A-Z]{2}[0-9]+ (Options v1)
DERIV_ACCOUNT_ID=VRTC0000000

# Transport: "options_otp" (Deriv Options v1 REST OTP -> /demo WS + bootstrap balance) or "v3_authorize" (ws.derivws.com v3)
DERIV_WS_TRANSPORT=options_otp

# --- Account Mode Safety Boundary (Phase 1 Demo Only) ---
DERIV_ACCOUNT_MODE=demo
DERIV_ALLOW_LIVE_REAL_MONEY=0

# --- Explicit Ordered Phase 1 USDJPY 3-Book Priority List ---
DERIV_SOTA_BOOK_IDS=USDJPY.sota_ens5_m30_up.v1,USDJPY.sota_stack05_m30_up.v1,USDJPY.sota_ens5_m15_up.v1

# --- Tick Feed Mode ---
# "integrated" (default): single-loop public WS + authenticated WS (zero cross-process parquet race)
# "external": reads watermark-synchronized parquets written by deriv-sota-tick-stream.service
DERIV_SOTA_TICK_FEED_MODE=integrated
DERIV_SOTA_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD

# --- Stake, EV Gate, Buy Dispatch Delay & Persisted Risk Circuit Breakers ---
DERIV_SOTA_STAKE=1.0
DERIV_SOTA_MAX_STAKE_USD=5.0
DERIV_SOTA_MAX_DAILY_LOSS_USD=25.0
DERIV_SOTA_MAX_DRAWDOWN_USD=50.0
DERIV_SOTA_MAX_OPEN_CONTRACTS=3
DERIV_SOTA_MAX_USD_FACTOR_OPEN=3
DERIV_SOTA_MAX_JPY_FACTOR_OPEN=3
DERIV_SOTA_BREAKEVEN_CEILING=0.60
DERIV_SOTA_EV_MARGIN=0.005
DERIV_SOTA_MAX_BUY_DISPATCH_DELAY_S=4.0

# --- Canonical Queue DB, Credential Isolation Receipt & Storage Paths ---
DERIV_SOTA_QUEUE_DB=deriv_data/runtime/sota_trade_queue_demo.sqlite
DERIV_SOTA_CREDENTIAL_ISOLATION_RECEIPT=/home/sean/.config/binary-algo/sota-credential-isolation-receipt.json
DERIV_SOTA_TICK_STORE_DIR=deriv_data/sota_ticks_1s
DERIV_SOTA_LOG_DIR=logs/sota_runtime
