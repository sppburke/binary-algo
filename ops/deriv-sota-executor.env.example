# Copy outside git before filling real credentials (chmod 600):
#   mkdir -p ~/.config/binary-algo && chmod 700 ~/.config/binary-algo
#   cp ops/deriv-sota-executor.env.example ~/.config/binary-algo/deriv-sota-executor.env
#   chmod 600 ~/.config/binary-algo/deriv-sota-executor.env

# --- Deriv API Credentials ---
DERIV_APP_ID=replace_with_deriv_app_id
DERIV_PAT=replace_with_demo_or_live_pat
# Demo account IDs start with VRTC... ; Real-money account IDs start with CR...
DERIV_ACCOUNT_ID=VRTC0000000

# Transport: "options_otp" (Deriv Options v1 REST OTP -> /demo or /live WS) or "v3_authorize" (ws.derivws.com v3)
DERIV_WS_TRANSPORT=options_otp

# --- Account Mode Safety Boundary ---
# Default fail-closed to "demo".
# To trade real money AFTER Demo VENUE_SETTLED passes (n >= 50, EV CI95_lo > 0):
#   1. Switch DERIV_ACCOUNT_ID to your CR... USD account and DERIV_PAT to its token
#   2. Set DERIV_ACCOUNT_MODE=live
#   3. Set DERIV_ALLOW_LIVE_REAL_MONEY=1
DERIV_ACCOUNT_MODE=demo
DERIV_ALLOW_LIVE_REAL_MONEY=0

# --- Tick Feed Mode ---
# "integrated" (default): single-loop public WS + authenticated WS (zero cross-process parquet race)
# "external": reads watermark-synchronized parquets written by deriv-sota-tick-stream.service
DERIV_SOTA_TICK_FEED_MODE=integrated
DERIV_SOTA_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD

# --- Stake, EV Gate & Persisted Risk Circuit Breakers ---
DERIV_SOTA_STAKE=1.0
DERIV_SOTA_MAX_STAKE_USD=5.0
DERIV_SOTA_MAX_DAILY_LOSS_USD=25.0
DERIV_SOTA_MAX_DRAWDOWN_USD=50.0
DERIV_SOTA_MAX_OPEN_CONTRACTS=4
DERIV_SOTA_MAX_USD_FACTOR_OPEN=2
DERIV_SOTA_MAX_JPY_FACTOR_OPEN=2
DERIV_SOTA_BREAKEVEN_CEILING=0.60
DERIV_SOTA_EV_MARGIN=0.005

# --- Storage & Logging Paths ---
DERIV_SOTA_TICK_STORE_DIR=deriv_data/sota_ticks_1s
DERIV_SOTA_LOG_DIR=logs/sota_runtime
