[Unit]
Description=binary-algo Deriv SOTA certified multi-book EV-gated executor (Demo VRTC only — Phase 1 hardened)
After=network-online.target
Wants=network-online.target
Conflicts=deriv-trade-executor.service deriv-demo-executor.service deriv-demo-executor.timer
ConditionPathExists=!%h/.local/state/binary-algo/locks/sota_activation.hold

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=JOBLIB_MULTIPROCESSING=0
UnsetEnvironment=PYTHONPATH PYTHONSTARTUP PYTHONHOME PYTHONUSERBASE PYTHONINSPECT PYTHONWARNINGS PYTHONCOERCECLOCALE
EnvironmentFile=%h/.config/binary-algo/deriv-sota-executor.env
WorkingDirectory=%h/git/binary-algo
ExecStartPre=%h/binary-algo-venv/bin/python -B -E -s scripts/vps_preflight.py --offline-only --phase1-policy --require-explicit-book-ids --enforce-3book-cutover --account-mode ${DERIV_ACCOUNT_MODE} --book-ids ${DERIV_SOTA_BOOK_IDS} --stake ${DERIV_SOTA_STAKE} --max-stake-usd ${DERIV_SOTA_MAX_STAKE_USD} --max-daily-loss-usd ${DERIV_SOTA_MAX_DAILY_LOSS_USD} --max-drawdown-usd ${DERIV_SOTA_MAX_DRAWDOWN_USD} --max-open-contracts ${DERIV_SOTA_MAX_OPEN_CONTRACTS} --max-usd-factor-open ${DERIV_SOTA_MAX_USD_FACTOR_OPEN} --max-jpy-factor-open ${DERIV_SOTA_MAX_JPY_FACTOR_OPEN} --absolute-breakeven-ceiling ${DERIV_SOTA_BREAKEVEN_CEILING} --ev-margin ${DERIV_SOTA_EV_MARGIN} --max-buy-dispatch-delay-s ${DERIV_SOTA_MAX_BUY_DISPATCH_DELAY_S} --queue-db ${DERIV_SOTA_QUEUE_DB} --log-dir ${DERIV_SOTA_LOG_DIR} --credential-isolation-receipt ${DERIV_SOTA_CREDENTIAL_ISOLATION_RECEIPT}
ExecStart=%h/binary-algo-venv/bin/python -B -E -s scripts/deriv_sota_executor.py --run --phase1-policy --require-explicit-book-ids --enforce-3book-cutover --account-mode ${DERIV_ACCOUNT_MODE} --book-ids ${DERIV_SOTA_BOOK_IDS} --tick-feed-mode ${DERIV_SOTA_TICK_FEED_MODE} --tick-store-dir ${DERIV_SOTA_TICK_STORE_DIR} --stake ${DERIV_SOTA_STAKE} --max-stake-usd ${DERIV_SOTA_MAX_STAKE_USD} --max-daily-loss-usd ${DERIV_SOTA_MAX_DAILY_LOSS_USD} --max-drawdown-usd ${DERIV_SOTA_MAX_DRAWDOWN_USD} --max-open-contracts ${DERIV_SOTA_MAX_OPEN_CONTRACTS} --max-usd-factor-open ${DERIV_SOTA_MAX_USD_FACTOR_OPEN} --max-jpy-factor-open ${DERIV_SOTA_MAX_JPY_FACTOR_OPEN} --absolute-breakeven-ceiling ${DERIV_SOTA_BREAKEVEN_CEILING} --ev-margin ${DERIV_SOTA_EV_MARGIN} --max-buy-dispatch-delay-s ${DERIV_SOTA_MAX_BUY_DISPATCH_DELAY_S} --queue-db ${DERIV_SOTA_QUEUE_DB} --log-dir ${DERIV_SOTA_LOG_DIR} --credential-isolation-receipt ${DERIV_SOTA_CREDENTIAL_ISOLATION_RECEIPT}
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
Nice=5
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=default.target
