[Unit]
Description=binary-algo Deriv trade executor (credentialed demo buyer; issue #6)
After=network-online.target
Wants=network-online.target
Conflicts=deriv-demo-executor.service deriv-demo-executor.timer

[Service]
Type=simple
EnvironmentFile=%h/.config/binary-algo/deriv-demo-executor.env
WorkingDirectory=/home/sean/git/binary-algo
# Sole credentialed buy-capable process. ExecStartPre scans /proc cmdlines and
# refuses to start if a legacy supervisor/demo-executor buy mode is still live.
ExecStartPre=/home/sean/binary-algo-venv/bin/python scripts/deriv_no_legacy_buy_guard.py
ExecStart=/home/sean/binary-algo-venv/bin/python scripts/deriv_trade_executor.py --run --log-dir ${DERIV_DEMO_LOG_DIR}/trade_executor --stake ${DERIV_DEMO_STAKE}
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
Nice=5
MemoryHigh=450M
MemoryMax=768M

[Install]
WantedBy=default.target
