{
  "schema": "m15-book-refresh-spec/v1",
  "issue": {
    "number": 9,
    "title": "Relaunch six incumbent 15m books with a date-only three-arm retrospective replay",
    "repository": "sppburke/binary-algo"
  },
  "pair_order": [
    "EURUSD",
    "USDJPY",
    "GBPUSD",
    "USDCHF",
    "AUDUSD",
    "NZDUSD"
  ],
  "feature_source_pair_order": [
    "EURUSD",
    "GBPUSD",
    "AUDUSD",
    "NZDUSD",
    "USDJPY",
    "USDCHF",
    "USDCAD"
  ],
  "feature_source_rules": {
    "authority": "live_features.PAIRS",
    "source_only_pairs": ["USDCAD"],
    "source_only_pairs_are_campaign_targets": false,
    "source_only_pairs_remain_required_for_cross_pair_feature_builds": true
  },
  "arm_order": [
    "A",
    "B",
    "C"
  ],
  "control_order": [
    ["eur_xpair_of", "B_perm"],
    ["eur_xpair_of", "C_perm"],
    ["gbpchf_xpair", "B_perm"],
    ["gbpchf_xpair", "C_perm"],
    ["own_pair", "B_perm"],
    ["own_pair", "C_perm"]
  ],
  "sealed_constants": {
    "horizon_seconds": 900,
    "breakeven": 0.541,
    "train_row_cap": 150000,
    "probability_tie_rule": "p>=0.5_is_UP",
    "confidence_gate_rule": "abs(p-0.5)>=threshold",
    "quantile_method": "linear",
    "bootstrap_seed": 9001,
    "control_bootstrap_seed": 9002,
    "shadow_bootstrap_seed": 9003,
    "stats_null_test_seed": 9005,
    "permutation_seeds": {
      "eur_xpair_of": 9101,
      "gbpchf_xpair": 9102,
      "own_pair": 9103
    },
    "block_lengths": [5, 10, 20],
    "production_bootstrap_replicates": 10000,
    "ddof": 1,
    "min_side_trades": 50,
    "min_activity_ratio": 0.8,
    "moved_up_rate_min": 0.47,
    "moved_up_rate_max": 0.53
  },
  "splits": {
    "entry_floor": "2012-01-01T00:00:00Z",
    "B": {
      "fit_label_exit_before": "2022-01-01T00:00:00Z",
      "calibration_entry_at_or_after": "2022-01-01T00:00:00Z",
      "calibration_label_exit_before": "2024-01-01T00:00:00Z"
    },
    "C": {
      "fit_label_exit_before": "2026-01-01T00:00:00Z",
      "calibration_entry_at_or_after": "2026-01-01T00:00:00Z",
      "calibration_label_exit_before": "2026-04-01T00:00:00Z"
    },
    "replay": {
      "entry_at_or_after": "2026-04-01T00:00:00Z",
      "entry_before": "2026-06-01T00:00:00Z",
      "settlement_exit_before": "2026-06-01T00:00:00Z",
      "classification": "retrospective_replay"
    },
    "phase_zero": {
      "entry_at_or_after": "2026-01-01T00:00:00Z",
      "entry_before": "2026-04-01T00:00:00Z"
    }
  },
  "evaluator": {
    "schema": "m15-book-refresh-evaluator/v1",
    "decision_reference": "completed_minute_close",
    "timestamp_mapping": {
      "processed_10s_source_label": "left_edge_of_[label,label+10s)_bar",
      "processed_10s_close_observation_timestamp": "source_label_plus_10_seconds",
      "feature_source_label": "left_edge_of_[label,label+60s)_completed_minute_bar",
      "decision_timestamp": "feature_source_label_plus_60_seconds",
      "feature_information_latest_source": "processed_10s_bar_labeled_feature_source_label_plus_50_seconds_closing_at_decision_timestamp",
      "settlement_clock": "processed_10s_close_observation_timestamps",
      "causal_requirement": "decision_and_settlement_observation_timestamps_never_precede_the_close_values_they_represent",
      "pinned_runtime_evidence": "deriv_hot_daemon.score_from_snapshot_candidate_bar_close_equals_FeatureRow.timestamp_plus_1_minute"
    },
    "outer_session": {
      "name": "ny",
      "timezone": "America/New_York",
      "open": "08:00:00",
      "close": "17:00:00"
    },
    "last_start": {
      "timezone": "America/New_York",
      "reject_at_or_after": "16:35:00"
    },
    "settlement": {
      "canonical_helper": "min1_production.wc_ret",
      "horizon_s": 900,
      "tol_s": 10,
      "lag_s": 1,
      "entry": "first_observation_at_or_after_decision_plus_1s",
      "expiry": "decision_plus_1s_plus_900s",
      "exit": "last_observation_at_or_before_expiry",
      "require_distinct_observations": true,
      "ties": "lose"
    },
    "scheduler": {
      "canonical_helper": "min1_production.nonoverlap_chrono",
      "gap_s": 900,
      "scope": "combined_before_side"
    },
    "probability_metrics": {
      "moved_rows_only": ["auc", "brier", "log_loss"],
      "tie_rate_reported_separately": true
    },
    "excluded": [
      "payout_admission",
      "account_limits",
      "staking",
      "allocator_ranking",
      "portfolio_exposure"
    ]
  },
  "cap_selector": {
    "schema": "timestamp-rank-cap/v1",
    "row_id": "signed_int64_unix_nanoseconds",
    "apply_after": ["family_filter", "fitting_session", "stride_phase"],
    "sort": "fit_row_id_ascending",
    "reject": ["duplicate", "non_finite", "out_of_int64_range"],
    "if_n_le_cap": "all_rows",
    "if_n_gt_cap": "unique_floor_linspace_zero_to_n_minus_1_inclusive",
    "cap": 150000,
    "label_blind": true
  },
