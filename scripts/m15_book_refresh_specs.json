  "identity": {
    "canonical_json": {
      "sort_keys": true,
      "separators": [",", ":"],
      "ensure_ascii": false,
      "allow_nan": false,
      "newline": false
    },
    "component_prefix": "unsigned_64_bit_big_endian_byte_length",
    "digest": "sha256_full_64_lower_hex",
    "path_normalization": "repo_relative_posix",
    "domains": {
      "evaluator_id": "m15-book-refresh/evaluator-id/v1",
      "prereg_id": "m15-book-refresh/prereg-id/v1",
      "bundle_id": "m15-book-refresh/bundle-id/v1",
      "controls_id": "m15-book-refresh/controls-id/v1",
      "run_id": "m15-book-refresh/run-id/v1"
    },
    "bundle_components": [
      "canonical_resolved_bundle_spec_without_bundle_id",
      "strategy_filename_and_exact_bytes",
      "model_filename_and_exact_bytes_in_seed_order"
    ]
  },
  "phases": [
    "source_preregistration",
    "derived_data",
    "adapter_parity",
    "fit_and_repeat",
    "arm_seal",
    "replay",
    "status_and_publication_lock",
    "candidate_publication",
    "shadow_spec"
  ],
  "phase_manifest": {
    "schema": "m15-book-refresh-phase/v1",
    "required": [
      "phase",
      "status",
      "canonical_attempt_id",
      "predecessor_manifest_hashes",
      "input_hashes",
      "output_hashes"
    ],
    "sealed_behavior": "verify_and_noop",
    "partial_behavior": "delete_and_restart_from_last_sealed_predecessor",
    "published_candidate_exception": "authenticate_external_lock_then_verify_and_finish_or_fail_closed"
  },
  "primary_family": {
    "schema": "m15-book-refresh-main-family/v1",
    "m0": 24,
    "tail": "two_sided_absolute_max_t",
    "endpoint_order": [
      "C_minus_B_yield_by_pair_order",
      "C_minus_A_yield_by_pair_order",
      "C_UP_accuracy_minus_0.5_by_pair_order",
      "C_DOWN_accuracy_minus_0.5_by_pair_order"
    ],
    "bonferroni_floor": "Phi^-1(1-0.05/(2*24))",
    "block_length_envelope": {"lower": "minimum", "upper": "maximum"}
  },
  "control_family": {
    "schema": "m15-book-refresh-control-family/v1",
    "representatives": {
      "eur_xpair_of": "EURUSD",
      "gbpchf_xpair": "GBPUSD",
      "own_pair": "USDJPY"
    },
    "m0": 9,
    "tail": "lower_only_max_t",
    "endpoints_per_representative": [
      "C_perm_minus_B_perm_yield",
      "C_perm_UP_accuracy_minus_0.5",
      "C_perm_DOWN_accuracy_minus_0.5"
    ],
    "bonferroni_floor": "Phi^-1(1-0.05/9)",
    "count_screen": {"C_perm_min_each_side": 50, "C_perm_to_B_perm_activity_min": 0.8},
    "label_permutation": {
      "generator": "numpy.random.Generator",
      "bit_generator": "numpy.random.PCG64",
      "seed_sequence": ["family_permutation_seed", "arm_code"],
      "arm_codes": {"B_perm": 0, "C_perm": 1},
      "partition_order": ["capped_fit_rows", "early_stopping_rows"],
      "state": "one_generator_consumed_sequentially_across_partition_order",
      "operation": "rng.permutation(len(partition))",
      "assignment": "labels[partition]=labels[partition][permutation]",
      "calibration_gate_label_values": "none"
    }
  },
  "status_precedence": [
    "INVALID_integrity_identity_access_parity_clock_control",
    "INCONCLUSIVE_required_endpoint_noncomputable",
    "PROMOTE_TO_SHADOW",
    "RETAIN_V1",
    "INCONCLUSIVE_remaining"
  ],
  "promotion": {
    "C_min_trades_each_side": 50,
    "lower_C_minus_B_yield_gt": 0.0,
    "lower_C_minus_A_yield_gt": 0.0,
    "lower_C_each_side_accuracy_minus_0.5_gt": 0.0,
    "C_to_B_activity_min": 0.8,
    "C_to_A_activity_min": 0.8,
    "each_month_min_each_side": 1,
    "each_month_whole_book_yield_min": 0.0,
    "whole_book_only": true
  },
  "retention": {
    "adequately_sampled": "A_B_C_each_at_least_50_each_side",
    "upper_C_minus_A_yield_lt": 0.0,
    "or_upper_C_either_side_accuracy_minus_0.5_le": 0.0
  },
