      "fixture_index",
      "helper_code",
      "k_shadow_or_0",
      "campaign_index",
      "L_or_0",
      "stream_code"
    ]
  },
  "publication": {
    "candidate_schema": "book-manifest/candidate-v1",
    "lifecycle_status": "inactive_shadow_candidate",
    "destination_parent": "books",
    "destination_must_not_exist": true,
    "files": [
      "<book_id>.resolved_bundle_spec.json",
